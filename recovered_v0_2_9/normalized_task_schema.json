{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedTask v0.2.6",
  "type": "object",
  "required": ["actions","preservation","performance_dimensions","evidence_policy","ui_requirements","architecture","external_state","execution","capabilities","risks","feature_evidence","unknowns","contradictions"],
  "properties": {
    "actions": {"type":"array","uniqueItems":true,"items":{"enum":["CREATE","MODIFY","DIAGNOSE","REVIEW","RESEARCH","ANALYZE_EVIDENCE","ANALYZE_DATA","DESIGN","OPTIMIZE","OPERATE"]}},
    "preservation": {"type":"array","uniqueItems":true,"items":{"enum":["BEHAVIOR","API","OUTPUT","MEANING","QUALITY","COMPATIBILITY"]}},
    "performance_dimensions": {"type":"array","uniqueItems":true,"items":{"enum":["LATENCY","THROUGHPUT","MEMORY","COMPUTE","FINANCIAL_COST","TOKEN_COST","QUALITY_ACCURACY","RESOURCE_UTILIZATION","GENERAL"]}},
    "evidence_policy": {"type":"array","uniqueItems":true,"items":{"enum":["OPEN","SUPPLIED_ONLY","CURRENT_EXTERNAL","TRACEABLE"]}},
    "ui_requirements": {"type":"array","uniqueItems":true,"items":{"enum":["UI","PRODUCTION","ACCESSIBILITY","RESPONSIVE","STATEFUL_UI"]}},
    "architecture": {"type":"array","uniqueItems":true,"items":{"enum":["DESIGN_BEFORE_BUILD","CHANGE","BOUNDARIES","MIGRATION"]}},
    "external_state": {"type":"array","uniqueItems":true,"items":{"enum":["EMAIL","CALENDAR","PUBLISHING","DATABASE","FILES","ACCOUNT","OTHER"]}},
    "execution": {"type":"array","uniqueItems":true,"items":{"enum":["MULTI_STEP","LARGE_WORKLOAD","PARALLELIZABLE","INDEPENDENT_REVIEW","EXPLICIT_MULTI_AGENT","HUMAN_APPROVAL","STATEFUL"]}},
    "capabilities": {"type":"array","uniqueItems":true,"items":{"enum":["WEB_CURRENT_EVIDENCE","FILE_READ","EMAIL_READ","EMAIL_WRITE","CALENDAR_READ","CALENDAR_WRITE","EXTERNAL_WRITE","AUTHORIZATION","CONNECTION_STATE","HUMAN_APPROVAL","PERSISTENT_STATE_READ","PERSISTENT_STATE_WRITE"]}},
    "risks": {"type":"object","additionalProperties":false,"properties":{"REVERSIBILITY":{"type":"integer","minimum":0,"maximum":4},"BLAST_RADIUS":{"type":"integer","minimum":0,"maximum":4},"FINANCIAL":{"type":"integer","minimum":0,"maximum":4},"LEGAL_REGULATORY":{"type":"integer","minimum":0,"maximum":4},"SECURITY":{"type":"integer","minimum":0,"maximum":4},"DATA_LOSS":{"type":"integer","minimum":0,"maximum":4},"REPUTATIONAL":{"type":"integer","minimum":0,"maximum":4}}},
    "feature_evidence": {"type":"object","additionalProperties":{"type":"object","required":["source","confidence"],"properties":{"source":{"enum":["EXPLICIT","INFERRED","UNKNOWN","CONTRADICTION"]},"confidence":{"type":"number","minimum":0,"maximum":1},"evidence_span":{"type":["string","null"]},"rationale":{"type":["string","null"]}}}},
    "unknowns": {"type":"array","items":{"type":"string"}},
    "contradictions": {"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": false
}
